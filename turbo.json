{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**", "generated/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    "//#format:check": {},

    "@aura/db#lint": { "dependsOn": ["@aura/db#build"] },
    "@aura/db#typecheck": { "dependsOn": ["@aura/db#build"] },
    "@aura/db#test": { "dependsOn": ["@aura/db#build"] },
    "@aura/db#test:integration": { "dependsOn": ["@aura/db#build"], "cache": false }
  }
}
