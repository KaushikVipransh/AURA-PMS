# AuraPMS — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored at every depth; this file is
# the only one that is committed, so it must never contain a real secret.
#
#     cp .env.example .env
#
# Variables are listed in the order the build introduces them, with the task
# that first needs each one. Anything marked "not needed yet" can stay blank
# until you reach that wave.

# ─── Database ────────────────────────────────────────────────────── W1-01 ───
# Matches docker-compose.yml. Host port is 5433, not 5432, to avoid colliding
# with a local Postgres install.
DATABASE_URL="postgresql://aura:aura_local_dev@localhost:5433/aurapms?schema=public"

# Neon pooled connection, used in preview and production only.
# DATABASE_URL_UNPOOLED=""

# ─── API server ──────────────────────────────────────────────────── W3-01 ───
NODE_ENV="development"
PORT="5000"

# Comma-separated allowlist. Replaces the prototype's bare `cors()` (PLAN.md
# F-01) — a wildcard here would reintroduce that finding.
CORS_ORIGINS="http://localhost:5173"

# ─── Auth ────────────────────────────────────────────────────────── W3-01 ───
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5000"

# ─── Frontend ────────────────────────────────────────────────────── W6-02 ───
# Vite only exposes variables prefixed VITE_ to client code. Never put a secret
# behind this prefix — it is compiled into the bundle.
VITE_API_URL="http://localhost:5000"

# ─── Background jobs ─────────────────────────────────────────────── W5-01 ───
# pg-boss runs inside the same Postgres, so there is no separate queue URL.
# It uses its own schema to keep job tables out of the application namespace.
PGBOSS_SCHEMA="pgboss"

# ─── Email ───────────────────────────────────────────────────────── W5-03 ───
# Not needed yet. Until this is set, the notification adapter logs instead of
# sending, so local development never emails a real person.
RESEND_API_KEY=""
EMAIL_FROM="AuraPMS <noreply@example.com>"

# ─── Export storage ──────────────────────────────────────────────── W5-05 ───
# Not needed yet. Cloudflare R2, S3-compatible.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="aurapms-exports"

# ─── Observability ───────────────────────────────────────────────── W7-01 ───
# Not needed yet. Leave blank to disable Sentry locally.
SENTRY_DSN=""
VITE_SENTRY_DSN=""
LOG_LEVEL="debug"
