enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PhaseKey {
  GOAL_SETTING
  CHECK_IN
  APPRAISAL
  CALIBRATION
  RESULTS
}

/// A performance period with dated phases.
///
/// This replaces `GLOBAL_ACTIVE_PERIOD`, the module-level string variable the
/// prototype used to track the current phase (PLAN.md F-03). That had two
/// failure modes: it reset on every Vercel cold start so concurrent instances
/// disagreed about what period it was, and changing it ran
/// `updateMany({}, { $set: { quarter } })`, stamping the new period onto every
/// sheet ever created and destroying all history.
///
/// Cycles are rows. Closing one leaves it readable forever.
model ReviewCycle {
  id         String @id @default(cuid())
  orgId      String
  name       String
  fiscalYear Int

  status CycleStatus @default(DRAFT)

  /// Snapshotted onto the cycle rather than referenced, so changing the scale
  /// later never rewrites a historical rating (PRD US-203).
  ratingScale Json @default("{}")

  /// Per-cycle escalation thresholds (PRD US-204).
  escalationRules Json @default("{}")

  /// When the self-appraisal is due, inside the APPRAISAL window.
  ///
  /// US-702 says a manager "cannot rate before self-appraisal submits or its
  /// deadline passes", and the phase table cannot express that: both
  /// `SUBMIT_SELF_APPRAISAL` and `SUBMIT_MANAGER_APPRAISAL` live in the
  /// APPRAISAL phase (W2-03), so treating the phase end as the self-appraisal
  /// deadline would mean the deadline and the manager's own window expire
  /// together — the manager could never rate an unsubmitted appraisal at all.
  ///
  /// Nullable, and null means **no deadline**: the manager waits for the
  /// submission. That is the strict reading, and it is the right default,
  /// because the alternative failure is a manager rating someone who was never
  /// given a chance to speak first.
  selfAppraisalDueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases      CyclePhase[]
  metrics     CycleMetrics[]
  goalSheets  GoalSheet[]
  sharedGoals SharedGoal[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@map("review_cycles")
}

/// A dated window within a cycle. Deadlines derive from `endsAt`, which is what
/// lets the escalation engine report real overdue days instead of the
/// prototype's `Math.max(elapsed, 4)` floor (PLAN.md F-08).
model CyclePhase {
  id      String @id @default(cuid())
  cycleId String

  key   PhaseKey
  label String

  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  /// One window per phase kind per cycle.
  @@unique([cycleId, key])
  @@index([cycleId, startsAt])
  @@map("cycle_phases")
}
