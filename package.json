{
  "name": "aurapms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuraPMS — enterprise performance management platform",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "verify": "turbo run lint typecheck test build",
    "verify:integration": "turbo run test:integration",
    "verify:full": "pnpm verify && pnpm verify:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  }
}
