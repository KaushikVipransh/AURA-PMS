{
  "name": "aurapms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuraPMS — enterprise performance management platform",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "verify": "turbo run lint typecheck test build",
    "verify:integration": "turbo run test:integration",
    "verify:full": "pnpm verify && pnpm verify:integration && pnpm test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @aura/db db:migrate",
    "db:generate": "pnpm --filter @aura/db db:generate",
    "db:studio": "pnpm --filter @aura/db db:studio",
    "db:reset": "pnpm --filter @aura/db db:reset"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.6.1",
    "vitest": "^4.1.10"
  }
}
