{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "pg-boss job processor: escalations, notifications, exports, digests",
  "scripts": {
    "build": "echo no-op",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@aura/config": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aura/contracts": "workspace:*",
    "@aura/core": "workspace:*",
    "@aura/db": "workspace:*",
    "dotenv": "^17.4.2",
    "pg-boss": "^12.27.0"
  }
}
